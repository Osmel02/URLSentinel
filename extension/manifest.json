{
    "manifest_version": 3,
    "name": "URLSentinel",
    "description": "Escaner de urls en busca de amenazas",
    "version": "1.0",

    "background": {
        "service_worker": "background.js"
    },

    "permissions": [
        "tabs",
        "webNavigation",
        "storage",
        "notifications"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "icons":{
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action":{
        "default_popup": "popup/popup.html"
    }
}